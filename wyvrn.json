{
  "name": "cpp-httplib",
  "version": "0.0.0.2",
  "schemaVersion": 2,
  "kind": "HeaderOnlyLib",
  "cmakePackageName": "httplib",
  "description": "TODO: one-line description of cpp-httplib",
  "dependencies": {},
  "build": {
    "system": "cmake",
    "generator": [
      "Ninja Multi-Config",
      "Visual Studio 17 2022",
      "Visual Studio 16 2019"
    ],
    "configs": [
      "Debug",
      "Release",
      "RelWithDebInfo",
      "MinSizeRel"
    ],
    "configure": [
      "-DHTTPLIB_TEST=OFF"
    ],
    "installDir": "install"
  },
   "compatibility": {
    "compiler":         "exact",
    "arch":             "any",
    "compiler.version": "any",
    "compiler.cppstd":  "lte",
    "compiler.runtime": "any"
  }
}
